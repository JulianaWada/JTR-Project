# Copy to .env.local. Every key is optional locally: missing keys switch that service to test mode.
# The public address students use. Behind the website this is the website's address, e.g. https://julestechright.com
APP_URL=http://localhost:3200
WEBSITE_URL=https://jtr-project.vercel.app
# Extra domains that forward /academy here (comma-separated), besides jtr-project.vercel.app and julestechright.com.
ALLOWED_ORIGINS=
SESSION_SECRET=
# Supabase: Project settings > Database > Connection string (Transaction pooler, port 6543).
DATABASE_URL=
# Jules's teacher login, created on first start.
TEACHER_EMAIL=jules@julestechright.com
TEACHER_PASSWORD=
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=JTR Academy <academy@julestechright.com>
CRON_SECRET=
# Demo students and the demo teacher password. Leave empty in production.
DEMO_PASSWORD=
