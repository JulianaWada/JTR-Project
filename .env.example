# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for canonical links, hreflang, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.julestechright.com

# Anthropic API key for the JTR Assistant (server-side only, never sent to the browser).
ANTHROPIC_API_KEY=

# Resend API key for lead emails (server-side only). Without it, leads are printed to the
# terminal in development; in production sending fails until it is set.
RESEND_API_KEY=

# Inbox that receives new enquiries (defaults to the contact email in content/site.ts).
LEADS_TO_EMAIL=

# Sender address for lead emails. Must be on a domain verified in Resend.
LEADS_FROM_EMAIL="JTR Website <website@julestechright.com>"

# --- Database and admin board (/admin) ---

# Postgres for leads, Academy interest sign-ups and project settings, e.g. a Supabase connection string
# (the transaction pooler on port 6543 works). It can be the academy's database: the tables don't clash.
# Without it the site uses a built-in test database (PGlite), which on Vercel is wiped from time to time.
DATABASE_URL=

# Password for the admin board at /admin. Outside production the demo password "demo1234" is used when
# it is empty; in production /admin stays closed until it is set.
ADMIN_PASSWORD=
# Optional: the email address to sign in with, alongside the password.
ADMIN_EMAIL=

# Read access to the other JTR apps for the admin board. Without them it shows sample data.
# The academy's database (ideally a read-only role):
ACADEMY_DATABASE_URL=
# The WhatsApp sales agent's database (needs insert on "tenants" for "Add a business"):
WHATSAPP_AGENT_DATABASE_URL=
# The sales agent's address, for the owners' sign-in link, e.g. https://jtr-whatsapp-agent.vercel.app
WHATSAPP_AGENT_URL=
