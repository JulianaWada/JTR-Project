# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.julestechright.com

# Anthropic API key for the JTR Assistant (server-side only).
ANTHROPIC_API_KEY=

# Resend API key for lead emails (server-side only).
RESEND_API_KEY=
